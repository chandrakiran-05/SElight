        {
          "name": "choose_training_route",
          "line": 21,
          "kind": "FunctionDef",
          "doc": "Use annotated DEVELOPMENT images only; never use this at inference.\n\nquality[r]: per-image F1 at IoU >= 0.5 and confidence >= 0.25.\ncost[r]: pooled relative extra route time, original cost is zero.\nTies prefer original, then gamma, then CLAHE."
        },
        {
          "name": "fit_reference_policy",
          "line": 51,
          "kind": "FunctionDef",
          "doc": "Match the existing train() candidate search, without writing files.\n\nExpects the JSON produced by `python -m selight cache`.\nThe production CLI additionally writes policy.json, readable rules,\nthreshold-baseline selection, oracle diagnostics and provenance hashes."
        },
        {
          "name": "infer_one",
          "line": 108,
          "kind": "FunctionDef",
          "doc": "One selected transform and exactly one detector call; no labels needed.\n\nConstruct the enhancer and detector once, outside the image loop.\nInput is OpenCV BGR uint8. Callback is normally Detector.predict."
        }
      ],
      "imports": [
        "dataclasses",
        "numpy",
        "selight.core",
        "sklearn.tree",
        "typing"
      ],
      "module_doc": "Readable reference for the existing SELight algorithm (not a new model).\n\nRun from the project root. Reuses exactly the production image features and\ntransforms. Reference training matches experiment.train's selector search;\nuse the normal CLI to export a complete policy with hashes/provenance."
    },
